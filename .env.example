# Copia este archivo como .env y ajusta los valores.
# El servidor lee las variables del entorno del sistema (no carga .env por si solo).

PORT=3000
HTTPS_PORT=3443

# El servidor escucha en toda la red local para que el QR de firma externa
# funcione desde un celular o tablet en la misma Wi-Fi.
HOST=0.0.0.0

# Si quieres limitarlo solo a este equipo:
# HOST=127.0.0.1

# El QR usa HTTP por defecto para que el celular no instale certificados.
# Pon QR_HTTPS=1 solo si el celular ya confia en el certificado local.
QR_HTTPS=0

# URL publica que se incrusta en el QR. Si se define, manda sobre lo anterior.
# Para HTTPS sin instalar nada en el celular, usa un dominio con certificado publico:
# PUBLIC_URL=https://consentimientos.tu-dominio.com

# Ruta alternativa del archivo SQLite
# DB_FILE=./data/sgcpm.db

# Carpeta de datos persistente. En la nube apunta al disco montado.
# Incluye base, firmas, fotos, logo e historias.
# DATA_DIR=/var/data

# Identificador del despliegue. En Render/Railway/Fly se toma del commit.
# BUILD_ID=abc1234

# Actualizaciones de las pantallas abiertas:
# se configuran desde Ajustes > Actualizaciones y se guardan en la base.
